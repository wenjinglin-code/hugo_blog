index cede8a572594..36cfe984bf08 100644
--- a/drivers/tty/hvc/hvc_riscv_sbi.c
+++ b/drivers/tty/hvc/hvc_riscv_sbi.c
@@ -12,6 +12,7 @@
 #include <linux/types.h>
 
 #include <asm/sbi.h>
+#include <asm/early_console.h>
 
 #include "hvc_console.h"
 
@@ -63,21 +64,45 @@ static const struct hv_ops hvc_sbi_dbcn_ops = {
 static int __init hvc_sbi_init(void)
 {
 	int err;
+	const struct hv_ops *ops;
 
 	if (sbi_debug_console_available) {
-		err = PTR_ERR_OR_ZERO(hvc_alloc(0, 0, &hvc_sbi_dbcn_ops, 256));
-		if (err)
-			return err;
-		hvc_instantiate(0, 0, &hvc_sbi_dbcn_ops);
+		ops = &hvc_sbi_dbcn_ops;
 	} else if (IS_ENABLED(CONFIG_RISCV_SBI_V01)) {
-		err = PTR_ERR_OR_ZERO(hvc_alloc(0, 0, &hvc_sbi_v01_ops, 256));
-		if (err)
-			return err;
-		hvc_instantiate(0, 0, &hvc_sbi_v01_ops);
+		ops = &hvc_sbi_v01_ops;
 	} else {
 		return -ENODEV;
 	}
 
-	return 0;
+	hvc_instantiate(0, 0, ops); // 先检查 hvc_console 有没有注册
+	err = PTR_ERR_OR_ZERO(hvc_alloc(0, 0, ops, 256));
+	return err;
 }
 device_initcall(hvc_sbi_init);
+
+#ifdef CONFIG_RISCV_EARLY_CONSOLE
+static void sbi_early_putc(char c)
+{
+	unsigned int termno = 0;
+	int count = -1;
+
+	if (c == '\n')
+		sbi_early_putc('\r');
+
+	do {
+		count = hvc_sbi_tty_put(termno, &c, 1);
+	} while(count == 0 || count == -EAGAIN);
+}
+
+static void hvc_sbi_early_init_common(void)
+{
+	riscv_early_console_putc = sbi_early_putc;
+}
+
+void __init hvc_sbi_early_init(void)
+{
+	hvc_sbi_early_init_common();
+	add_preferred_console("hvc", 0, NULL); // 以便，成功注册hvc console
+	// hvc_instantiate(index, index, ops);
+}
+#endif /* CONFIG_RISCV_EARLY_CONSOLE */
